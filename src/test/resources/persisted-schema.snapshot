class CachedPrice {
  avg: long
  high: long
  highTime: long
  low: long
  lowTime: long
}
class CategoryData {
  categories: List<CategoryState>
  favoritesCollapsed: boolean
  uncategorizedCollapsed: boolean
}
class CategoryState {
  collapsed: boolean
  name: String
}
class PersistedItem {
  category: String
  favorite: boolean
  itemId: int
  onOverlay: boolean
}
